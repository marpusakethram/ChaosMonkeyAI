# Optional. Without a key everything runs in deterministic offline fixture mode.
# Get a free-tier key at https://aistudio.google.com/apikey . Never commit .env.
GEMINI_API_KEY=
# Free-tier Flash-Lite model by default; check your project's limits in AI Studio.
GEMINI_MODEL=gemini-2.5-flash-lite
# Local requests-per-minute ceiling for the Gemini limiter (keep at/below your free-tier RPM).
GEMINI_RPM=5

# Hard budgets per run
MAX_TOOL_CALLS=16
MAX_AGENT_STEPS=24
MAX_RUN_SECONDS=20
MAX_GEMINI_REQUESTS_PER_RUN=8
MAX_RETRIES_PER_CALL=3
MAX_FAULT_INJECTIONS_PER_RUN=3
TOOL_TIMEOUT_MS=400
MAX_CONCURRENT_RUNS=4

# Trace storage
TRACE_MAX_BYTES=1000000
RETENTION_DAYS=14
# CHAOS_DATA_DIR=./data
